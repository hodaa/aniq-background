{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aniq-background",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/15 * * * *",
      "0 0 * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
